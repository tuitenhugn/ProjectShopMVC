@model IEnumerable<ProjectShopMVC.Models.Product>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewData["Categories"] as List<ProjectShopMVC.Models.Category> ?? new List<ProjectShopMVC.Models.Category>();
}

<style>
    body {
        background-color: #f4f7f6;
    }

    .container-fluid {
        padding-top: 20px;
        padding-bottom: 20px;
    }

    .crud-header {
        background-color: #ffffff;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .crud-table-container {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 15px;
    }

    .table thead th {
        background-color: #007bff;
        color: white;
        border: none;
        vertical-align: middle;
        font-weight: 600;
    }

    .table tbody tr:hover {
        background-color: #e9ecef;
        cursor: pointer;
    }
</style>

<div class="crud-header">
    <h2>Quản Lý Sản Phẩm</h2>
    <a class="btn btn-primary" href="/Products/Create">
        <i class="bi bi-plus-circle"></i> Thêm Sản Phẩm Mới
    </a>
</div>

<div class="crud-table-container">
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="productsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Slug</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr id="row_@p.Id">
                        <td>@p.Id</td>
                        <td>
                            <img src="@(p.ImageUrl ?? "/images/no-image.png")" alt="@p.Name"
                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                        </td>
                        <td>@p.Name</td>
                        <td>@p.Slug</td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Price.ToString("C")</td>
                        <td>@p.Stock</td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-warning")">
                                @(p.IsActive ? "Hoạt động" : "Ẩn")
                            </span>
                        </td>
                        <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a class="btn btn-sm btn-info" href="/Products/Edit/@p.Id">Sửa</a>
                            <button class="btn btn-sm btn-danger" onclick="openDeleteModal(@p.Id, '@p.Name')">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Xác nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác Nhận Xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa sản phẩm **<span id="deleteProductName"></span>** này không?
                <input type="hidden" id="deleteProductId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModalEl = document.getElementById('deleteModal');
        const deleteModal = new bootstrap.Modal(deleteModalEl);

        // Hàm mở Modal Xác nhận Xóa
        function openDeleteModal(id, name) {
            document.getElementById('deleteProductName').textContent = name;
            document.getElementById('deleteProductId').value = id;
            deleteModal.show();
        }

        // Hàm thực hiện Xóa
        async function confirmDelete() {
            const id = document.getElementById('deleteProductId').value;
            try {
                const response = await fetch(`/Products/Delete?id=${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    alert(`Đã xóa sản phẩm ID: ${id}`);
                    deleteModal.hide();
                    const row = document.getElementById(`row_${result.productId}`);
                    if (row) row.remove();
                } else {
                    alert('Lỗi xóa: ' + (result.error || 'Không thể xóa sản phẩm.'));
                }
            } catch (error) {
                alert('Lỗi kết nối server: ' + error.message);
            }
        }
    </script>
}
