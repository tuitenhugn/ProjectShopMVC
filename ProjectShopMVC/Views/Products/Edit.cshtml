@model ProjectShopMVC.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form asp-action="Edit" asp-controller="Products" enctype="multipart/form-data" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" class="form-control" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Category</label>
        <select asp-for="CategoryId"
                asp-items="@(new SelectList(ViewData["Categories"] as List<ProjectShopMVC.Models.Category>, "Id", "Name", Model.CategoryId))"
                class="form-control">
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <!-- Hiển thị ảnh hiện tại -->
    <div class="form-group mb-3">
        <label>Current Image</label><br />
        <img src="@(Model.ImageUrl ?? "/images/no-image.png")" alt="@Model.Name" style="width:100px; height:100px; object-fit:cover; border-radius:5px;" />
    </div>

    <!-- Upload ảnh mới -->
    <div class="form-group mb-3">
        <label>Upload New Image</label>
        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="AdminIndex" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
