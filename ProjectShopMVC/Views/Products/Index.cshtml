@model IEnumerable<ProjectShopMVC.Models.Product>
@using Newtonsoft.Json
@{
    // Đổi tên view thành Index.cshtml nhưng giữ nội dung quản lý
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewData["Categories"] as List<ProjectShopMVC.Models.Category> ?? new List<ProjectShopMVC.Models.Category>();
}

<style>
    /* Styling improvements for a cleaner, modern look */
    body {
        background-color: #f4f7f6; /* Light background for contrast */
    }

    .container-fluid {
        padding-top: 20px;
        padding-bottom: 20px;
    }
    /* Header (Tiêu đề và nút thêm) */
    .crud-header {
        background-color: #ffffff;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    /* Table Container */
    .crud-table-container {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 15px;
    }
    /* Table Header */
    .table thead th {
        background-color: #007bff; /* Primary color header */
        color: white;
        border: none;
        vertical-align: middle;
        font-weight: 600;
    }
    /* Table Row Hover Effect */
    .table tbody tr:hover {
        background-color: #e9ecef; /* Subtle hover effect */
        cursor: pointer;
    }
    /* Modal Styling */
    .modal-content {
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        background-color: #007bff;
        color: white;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

        .modal-header .btn-close {
            filter: invert(1); /* Ensure close button is visible on dark background */
            color: white; /* Fallback for close button color */
        }
</style>

<div class="crud-header">
    <h2>Quản Lý Sản Phẩm</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEditModal" onclick="openCreateModal()">
        <i class="bi bi-plus-circle"></i> Thêm Sản Phẩm Mới
    </button>
</div>

<div class="crud-table-container">
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="productsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Slug</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr id="row_@p.Id">
                        <td>@p.Id</td>
                        <td><img src="@(p.ImageUrl ?? "/images/no-image.png")" alt="@p.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" /></td>
                        <td id="name_@p.Id">@p.Name</td>
                        <td id="slug_@p.Id">@p.Slug</td>
                        <td id="category_@p.Id" data-category-id="@p.CategoryId">@p.Category?.Name</td>
                        <td id="price_@p.Id">@p.Price.ToString("C")</td>
                        <td id="stock_@p.Id">@p.Stock</td>
                        <td id="active_@p.Id" data-is-active="@p.IsActive.ToString().ToLower()">
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-warning")">@(p.IsActive ? "Hoạt động" : "Ẩn")</span>
                        </td>
                        <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-info" onclick="openEditModal(@p.Id)">Sửa</button>
                            <button class="btn btn-sm btn-danger" onclick="openDeleteModal(@p.Id, '@p.Name')">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm/Sửa Sản Phẩm -->
<div class="modal fade" id="createEditModal" tabindex="-1" aria-labelledby="createEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createEditModalLabel">Thêm Sản Phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <input type="hidden" id="ProductId" name="Id" value="0" />
                    <input type="hidden" id="CreatedAt" name="CreatedAt" /> @* Giữ lại CreatedAt khi Edit *@

                    <div class="mb-3">
                        <label for="ProductName" class="form-label">Tên Sản Phẩm</label>
                        <input type="text" class="form-control" id="ProductName" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="ProductSlug" class="form-label">Slug (URL thân thiện)</label>
                        <input type="text" class="form-control" id="ProductSlug" name="Slug" />
                    </div>
                    <div class="mb-3">
                        <label for="ProductDescription" class="form-label">Mô Tả</label>
                        <textarea class="form-control" id="ProductDescription" name="Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="ProductPrice" class="form-label">Giá (VNĐ)</label>
                        <input type="number" step="0.01" class="form-control" id="ProductPrice" name="Price" required />
                    </div>
                    <div class="mb-3">
                        <label for="ProductStock" class="form-label">Tồn Kho</label>
                        <input type="number" step="1" class="form-control" id="ProductStock" name="Stock" required value="0" />
                    </div>
                    <div class="mb-3">
                        <label for="ProductCategoryId" class="form-label">Danh Mục</label>
                        <select class="form-select" id="ProductCategoryId" name="CategoryId" required>
                            <option value="">-- Chọn Danh Mục --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="ProductImageUrl" class="form-label">URL Ảnh</label>
                        <input type="url" class="form-control" id="ProductImageUrl" name="ImageURL" />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="ProductIsActive" name="IsActive" value="true">
                        <label class="form-check-label" for="ProductIsActive">
                            Hoạt động (Hiển thị ra ngoài)
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="saveProductBtn" onclick="saveProduct()">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác Nhận Xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa sản phẩm **<span id="deleteProductName"></span>** này không?
                <input type="hidden" id="deleteProductId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khai báo các đối tượng Modal của Bootstrap
        const createEditModalEl = document.getElementById('createEditModal');
        const deleteModalEl = document.getElementById('deleteModal');
        const createEditModal = new bootstrap.Modal(createEditModalEl);
        const deleteModal = new bootstrap.Modal(deleteModalEl);
        const tableBody = document.querySelector('#productsTable tbody');
        // Chuyển danh sách Categories từ ViewData sang JS để dùng trong dropdown và cập nhật bảng
        // NOTE: Cần đảm bảo Controller ProductsController đã gán ViewData["Categories"]
        const categoriesList = @Html.Raw(JsonConvert.SerializeObject(categories));

        // Hàm hỗ trợ tìm tên danh mục từ ID
        function getCategoryName(id) {
            // ID có thể là null, undefined, hoặc 0 nếu không chọn
            if (!id) return 'N/A';
            const cat = categoriesList.find(c => c.id === id);
            return cat ? cat.name : 'N/A';
        }

        // Hàm mở Modal Tạo mới
        function openCreateModal() {
            document.getElementById('productForm').reset();
            document.getElementById('ProductId').value = '0';
            // Đặt giá trị mặc định cho Stock và IsActive
            document.getElementById('ProductStock').value = '0';
            document.getElementById('ProductIsActive').checked = true;
            document.getElementById('createEditModalLabel').textContent = 'Thêm Sản Phẩm Mới';
            document.getElementById('saveProductBtn').textContent = 'Thêm';
            createEditModal.show();
        }

        // Hàm mở Modal Chỉnh sửa
        async function openEditModal(id) {
            document.getElementById('createEditModalLabel').textContent = `Chỉnh Sửa Sản Phẩm #${id}`;
            document.getElementById('saveProductBtn').textContent = 'Lưu Thay Đổi';

            try {
                // Sử dụng endpoint GetProduct (cần tồn tại trong ProductsController)
                const response = await fetch(`/Products/GetProduct/${id}`);
                if (!response.ok) throw new Error('Không tìm thấy sản phẩm.');

                const product = await response.json();

                // Điền dữ liệu vào form
                document.getElementById('ProductId').value = product.id;
                document.getElementById('CreatedAt').value = product.createdAt;
                document.getElementById('ProductName').value = product.name;
                document.getElementById('ProductSlug').value = product.slug || '';
                document.getElementById('ProductDescription').value = product.description;
                document.getElementById('ProductPrice').value = product.price;
                document.getElementById('ProductStock').value = product.stock;
                document.getElementById('ProductCategoryId').value = product.categoryId;
                document.getElementById('ProductImageUrl').value = product.imageUrl || '';
                document.getElementById('ProductIsActive').checked = product.isActive;

                createEditModal.show();
            } catch (error) {
                alert('Lỗi khi tải dữ liệu sản phẩm: ' + error.message);
            }
        }

        // Hàm mở Modal Xác nhận Xóa
        function openDeleteModal(id, name) {
            document.getElementById('deleteProductName').textContent = name;
            document.getElementById('deleteProductId').value = id;
            deleteModal.show();
        }

        // Hàm gửi dữ liệu Thêm/Sửa
        async function saveProduct() {
            const form = document.getElementById('productForm');
            const isCreating = document.getElementById('ProductId').value === '0';
            const url = isCreating ? '/Products/Create' : '/Products/Edit';

            // Tạo đối tượng dữ liệu từ form
            const data = {
                Id: parseInt(document.getElementById('ProductId').value),
                Name: form.Name.value,
                Slug: form.Slug.value || null,
                Description: form.Description.value,
                Price: parseFloat(form.Price.value),
                Stock: parseInt(form.Stock.value),
                CategoryId: parseInt(form.CategoryId.value),
                ImageURL: form.ImageURL.value || null,
                IsActive: form.IsActive.checked,
                CreatedAt: form.CreatedAt.value // Chỉ có giá trị khi Edit
            };

            try {
                // Gửi yêu cầu POST/API
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    alert(isCreating ? 'Thêm sản phẩm thành công!' : 'Cập nhật sản phẩm thành công!');
                    createEditModal.hide();
                    // Cập nhật giao diện (Thêm hoặc Sửa hàng)
                    if (isCreating) {
                        insertNewRow(result.product);
                    } else {
                        updateExistingRow(result.product);
                    }
                } else {
                    // Xử lý lỗi từ server
                    const errorMessage = result.errors && result.errors.length > 0 ?
                                         result.errors.join('\n') :
                                         (result.error || 'Vui lòng kiểm tra lại dữ liệu nhập.');
                    alert('Lỗi: ' + errorMessage);
                }
            } catch (error) {
                alert('Lỗi kết nối server: ' + error.message);
            }
        }

        // Hàm thực hiện Xóa
        async function confirmDelete() {
            const id = document.getElementById('deleteProductId').value;

            try {
                // Gửi yêu cầu POST/API Delete (cần tồn tại trong ProductsController)
                const response = await fetch(`/Products/Delete?id=${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();

                if (result.success) {
                    alert(`Đã xóa sản phẩm ID: ${id}`);
                    deleteModal.hide();
                    // Xóa hàng trong bảng
                    const row = document.getElementById(`row_${result.productId}`);
                    if (row) row.remove();
                } else {
                    alert('Lỗi xóa: ' + (result.error || 'Không thể xóa sản phẩm.'));
                }
            } catch (error) {
                alert('Lỗi kết nối server: ' + error.message);
            }
        }

        // Hàm cập nhật hàng hiện có trong bảng
        function updateExistingRow(p) {
            const row = document.getElementById(`row_${p.id}`);
            if (!row) return;

            // Cập nhật các cell
            row.querySelector(`#name_${p.id}`).textContent = p.name;
            row.querySelector(`#slug_${p.id}`).textContent = p.slug || '';
            row.querySelector(`#category_${p.id}`).textContent = getCategoryName(p.categoryId);
            row.querySelector(`#category_${p.id}`).setAttribute('data-category-id', p.categoryId);
            row.querySelector(`#price_${p.id}`).textContent = p.price.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
            row.querySelector(`#stock_${p.id}`).textContent = p.stock;

            const activeCell = row.querySelector(`#active_${p.id}`);
            const badge = activeCell.querySelector('.badge');

            activeCell.setAttribute('data-is-active', p.isActive.toString().toLowerCase());
            badge.textContent = p.isActive ? 'Hoạt động' : 'Ẩn';
            badge.className = `badge ${p.isActive ? 'bg-success' : 'bg-warning'}`;

            // Cập nhật ảnh
            row.querySelector('img').src = p.imageUrl || '/images/no-image.png';
            row.querySelector('img').alt = p.name;
        }

        // Hàm chèn hàng mới vào bảng
        function insertNewRow(p) {
            const table = document.getElementById('productsTable').getElementsByTagName('tbody')[0];
            const newRow = table.insertRow(0); // Chèn lên đầu
            newRow.id = `row_${p.id}`;

            const categoryName = getCategoryName(p.categoryId);
            const priceFormatted = p.price.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });

            newRow.innerHTML = `
                <td>${p.id}</td>
                <td><img src="${p.imageUrl || '/images/no-image.png'}" alt="${p.name}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" /></td>
                <td id="name_${p.id}">${p.name}</td>
                <td id="slug_${p.id}">${p.slug || ''}</td>
                <td id="category_${p.id}" data-category-id="${p.categoryId}">${categoryName}</td>
                <td id="price_${p.id}">${priceFormatted}</td>
                <td id="stock_${p.id}">${p.stock}</td>
                <td id="active_${p.id}" data-is-active="${p.isActive.toString().toLowerCase()}">
                    <span class="badge ${p.isActive ? 'bg-success' : 'bg-warning'}">${p.isActive ? 'Hoạt động' : 'Ẩn'}</span>
                </td>
                <td>${new Date(p.createdAt).toLocaleDateString('vi-VN')}</td>
                <td>
                    <button class="btn btn-sm btn-info" onclick="openEditModal(${p.id})">Sửa</button>
                    <button class="btn btn-sm btn-danger" onclick="openDeleteModal(${p.id}, '${p.name.replace(/'/g, "\\'")}')">Xóa</button>
                </td>
            `;
        }
    </script>
}