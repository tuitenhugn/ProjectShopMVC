@model ProjectShopMVC.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container py-5">
    <div class="row">
        <!-- Ảnh sản phẩm -->
        <div class="col-md-6 text-center">
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="img-fluid rounded shadow"
                 style="max-height:450px; object-fit:contain;" />
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">
            <h2 class="fw-bold">@Model.Name</h2>

            @if (!string.IsNullOrEmpty(Model.Slug))
            {
                <p class="text-muted">Mã sản phẩm: @Model.Slug</p>
            }

            <h3 class="text-danger fw-bold mb-4">
                @Model.Price.ToString("n0")₫
            </h3>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="mb-4">@Model.Description</p>
            }

            <p>
                <strong>Danh mục:</strong>
                @Model.Category?.Name
            </p>

            <p>
                <strong>Tồn kho:</strong>
                @(Model.Stock > 0 ? $"{Model.Stock} sản phẩm" : "Hết hàng")
            </p>

            <p>
                <strong>Ngày tạo:</strong>
                @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </p>

            <!-- Nút thêm vào giỏ hàng -->
            <form method="post" asp-controller="ShoppingCart" asp-action="AddToCart">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button class="btn btn-dark btn-lg px-4 mt-3"
                        @(Model.Stock > 0 ? "" : "disabled")>
                    🛒 Thêm vào giỏ
                </button>
            </form>

            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary mt-3 ms-2">
                ← Quay lại danh sách
            </a>
        </div>
    </div>
</div>

