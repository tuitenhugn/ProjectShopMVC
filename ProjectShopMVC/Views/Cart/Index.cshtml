@model IEnumerable<ProjectShopMVC.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
    var items = Model?.ToList() ?? new List<ProjectShopMVC.Models.CartItem>();
    decimal total = items.Sum(i => i.Price * i.Quantity);
}
<h3>Giỏ hàng</h3>
@if (!items.Any())
{
    <p>Giỏ hàng rống</p>
}
else
{
    <table class="table">
        <thead><tr><th></th><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
        <tbody>
            @foreach(var it in items)
            {
                <tr>
                    <td><img src="@(it.ImageUrl ?? "/images/no-image.png")" style="height:60px;object-fit:cover;" /></td>
                    <td>@it.Name</td>
                    <td>@it.Price.ToString("C")</td>
                    <td>@it.Quantity</td>
                    <td>@(it.Price * it.Quantity).ToString("C")</td>
                    <td><button class="btn btn-sm btn-danger" onclick="deleteItem(@it.ProductId)">Xóa</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="4" class="text-end">T?ng</td><td>@total.ToString("C")</td><td></td></tr>
        </tfoot>
    </table>
    <a class="btn btn-success" href="#">Tiến hành thanh toán</a>
}

@section Scripts {
    <script>
        function deleteItem(id) {
            if (!confirm('Xóa sản phẩm khỏi giỏ')) return;
            fetch('/ShoppingCart/Delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'id=' + id })
                .then(r => r.json()).then(d => { if (d.Success) { location.reload(); } else { alert('Lỗi'); } });
        }
    </script>
}
